# 复制本文件为 .env.prod 并填入真实值（.env.prod 已被 .gitignore 忽略，切勿提交）
# 部署命令：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# ---- 数据库 ----
POSTGRES_PASSWORD=请改成强密码至少16位

# ---- 管理台登录（务必改掉默认密码）----
EVOAGENT_AUTH_SECRET=请生成随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(32))"
EVOAGENT_BOOTSTRAP_ADMIN_USERNAME=admin
EVOAGENT_BOOTSTRAP_ADMIN_PASSWORD=请改成至少10位强密码

# ---- LLM（启用 hybrid / agentic 高级模式需要）----
# 选项A DeepSeek 官方（付费、稳定），provider 保持 deepseek：
EVOAGENT_LLM_PROVIDER=deepseek
EVOAGENT_DEEPSEEK_API_KEY=
# 选项B OpenRouter 免费（限速、可用性波动）：取消下面两行注释，并把上面 provider 改成 openrouter-deepseek-free
# EVOAGENT_LLM_PROVIDER=openrouter-deepseek-free
# EVOAGENT_OPENROUTER_API_KEY=
# 选项C 任意 OpenAI 兼容端点：填下面三项，provider 改 custom
# EVOAGENT_LLM_PROVIDER=custom
# EVOAGENT_LLM_BASE_URL=https://example.com/v1
# EVOAGENT_LLM_API_KEY=
EVOAGENT_LLM_MODEL=deepseek-chat

# 默认运行模式：hybrid / agentic / rules-only（留空则按模型可用性自动降级）
EVOAGENT_DEFAULT_RUN_MODE=hybrid

# ---- 推送到 Docker Hub 后的完整镜像名（push_image.ps1 会用到）----
EVOAGENT_IMAGE=yourdockerhubuser/coding-evoagent:latest
